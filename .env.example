# Copy this file to .env and fill in values. .env is git-ignored.

# --- Database ---
# Leave unset (or use the line below) for local SQLite development.
DATABASE_URL=sqlite:///finsight.db
# For production Postgres, use something like:
# DATABASE_URL=postgresql+psycopg2://finsight:password@localhost:5432/finsight

# Set to 1 to echo all SQL to the console while debugging.
SQL_ECHO=0

# --- External API keys (added in the ingestion phase) ---
NEWSAPI_KEY=your_newsapi_key_here
ALPHAVANTAGE_KEY=your_alphavantage_key_here
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=finsight-ai/0.1

# --- Sentiment analysis ---
SENTIMENT_CONFIDENCE_THRESHOLD=0.6

# --- Signal aggregation ---
SIGNAL_WINDOW_HOURS=6
SIGNAL_STRONG_THRESHOLD=0.6
SIGNAL_MODERATE_THRESHOLD=0.2

# --- Alerts ---
DEFAULT_ALERT_THRESHOLD=0.60
